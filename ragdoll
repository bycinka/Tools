local function ApplySpeedTool()
    local tool = Instance.new("Tool")
    tool.RequiresHandle = false
    tool.Name = "SpeedTool"
    tool.Parent = LP.Backpack

    local baseSpeed, minSpeed, maxSpeed, step = 16, 1, 16, 0.5
    local speed = baseSpeed
    local savedSpeed = nil
    local eHeld, qHeld = false, false
    local eLoop, qLoop = nil, nil
    local conns = {}

    local function applySpeed()
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.WalkSpeed = speed end
    end

    local function setSpeed(v)
        speed = math.clamp(v, minSpeed, maxSpeed)
        applySpeed()
    end

    local function startLoop(key)
        if key == "E" then
            if eLoop then return end
            eLoop = task.spawn(function()
                while eHeld and tool.Parent == LP.Character do
                    setSpeed(speed + step)
                    task.wait(0.1)
                end
                eLoop = nil
            end)
        else
            if qLoop then return end
            qLoop = task.spawn(function()
                while qHeld and tool.Parent == LP.Character do
                    setSpeed(speed - step)
                    task.wait(0.1)
                end
                qLoop = nil
            end)
        end
    end

    local function stopLoop(key)
        if key == "E" then
            eHeld = false
            eLoop = nil
        else
            qHeld = false
            qLoop = nil
        end
    end

    local function onInput(input, processed)
        if processed or tool.Parent ~= LP.Character then return end
        if input.KeyCode == Enum.KeyCode.E then
            if not eHeld then
                eHeld = true
                setSpeed(speed + step)
                startLoop("E")
            end
        elseif input.KeyCode == Enum.KeyCode.Q then
            if not qHeld then
                qHeld = true
                setSpeed(speed - step)
                startLoop("Q")
            end
        elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
            if not savedSpeed then
                savedSpeed = speed
                setSpeed(speed * 0.2)
            end
        end
    end

    local function onInputEnded(input)
        if input.KeyCode == Enum.KeyCode.E then
            stopLoop("E")
        elseif input.KeyCode == Enum.KeyCode.Q then
            stopLoop("Q")
        elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
            if savedSpeed then
                speed = savedSpeed
                savedSpeed = nil
                applySpeed()
            end
        end
    end

    table.insert(conns, UIS.InputBegan:Connect(onInput))
    table.insert(conns, UIS.InputEnded:Connect(onInputEnded))

    tool.Equipped:Connect(function()
        speed = baseSpeed
        savedSpeed = nil
        stopLoop("E")
        stopLoop("Q")
        applySpeed()
    end)

    tool.Unequipped:Connect(function()
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.WalkSpeed = baseSpeed end
        savedSpeed = nil
        stopLoop("E")
        stopLoop("Q")
    end)

    tool.Destroying:Connect(function()
        stopLoop("E")
        stopLoop("Q")
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end)
end

