local AFKHooked = false

local function ApplyAFKBlock(state)
    getgenv().AFKBlock = state
    local AFK = RS:FindFirstChild("AFK")
    if not AFK or AFKHooked then return end
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getgenv().AFKBlock and self == AFK and getnamecallmethod() == "FireServer" then return end
        return old(self, ...)
    end)
    setreadonly(mt, true)
    AFKHooked = true
end

